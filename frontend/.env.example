VITE_API_BASE_URL=http://localhost:8000

# Optional: a TURN server for WebRTC across restrictive NATs (see README >
# Known limitations). Leave unset to use only the public STUN server --
# fine for same-machine/LAN use. docker-compose.yml sets these
# automatically for the bundled `coturn` service.
# VITE_TURN_URL=turn:localhost:3478
# VITE_TURN_USERNAME=vbdemo
# VITE_TURN_CREDENTIAL=vbdemo
